VITE_API_URL=http://localhost:3000
# Optional: bounds of the visible schedule range (defaults shown)
VITE_SCHEDULE_START=07:00
VITE_SCHEDULE_END=22:00
# Optional: day high at or below this temperature shows the cold glyph
VITE_WEATHER_COLD_THRESHOLD=0
# Optional: auto theme switches light/dark at these times (defaults shown)
VITE_THEME_MODE=auto
VITE_THEME_LIGHT_START=07:00
VITE_THEME_DARK_START=20:00
# Optional: VITE_SKIN=default|woodland (default shown)
VITE_SKIN=default
# Optional: VITE_BACKGROUND=none disables the background image;
# VITE_BACKGROUND_LIGHT / VITE_BACKGROUND_DARK override the bundled images
VITE_BACKGROUND=
VITE_BACKGROUND_LIGHT=
VITE_BACKGROUND_DARK=
# Comma-separated list of allowed CORS and OAuth return origins
APP_ORIGIN=http://localhost:8080,http://localhost:5173
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: comma-separated Google Tasks list titles (unset shows every list)
TASK_LISTS=Reminders,Groceries
WEATHER_LATITUDE=
WEATHER_LONGITUDE=
# Optional: WEATHER_UNITS=celsius|fahrenheit (default celsius)
WEATHER_UNITS=celsius
# Optional: WEATHER_WIND_UNIT=kn|kmh|mph (default kn)
WEATHER_WIND_UNIT=kn

# Optional: host port for the web container (default 8080)
WEB_PORT=8080

# Optional Photos: separate web OAuth client; enable Google Photos Picker API.
GOOGLE_PHOTOS_CLIENT_ID=
GOOGLE_PHOTOS_CLIENT_SECRET=
GOOGLE_PHOTOS_REDIRECT_URI=http://localhost:3000/api/photos/callback
