#!/bin/sh
log=/home/kiosk/.config/idle.log
# Display stays on from DISPLAY_ON to DISPLAY_OFF (HH:MM, e.g. set in ~/.config/labwc/environment).
off=${DISPLAY_OFF:-21:15}; off=${off%:*}${off#*:}
on=${DISPLAY_ON:-07:00}; on=${on%:*}${on#*:}
case $off in [0-2][0-9][0-5][0-9]) ;; *) off=2115 ;; esac
case $on in [0-2][0-9][0-5][0-9]) ;; *) on=0700 ;; esac
if [ "$off" -lt "$on" ]; then night="[ \$t -ge $off ] && [ \$t -lt $on ]"; else night="[ \$t -ge $off ] || [ \$t -lt $on ]"; fi
# Blank after 30 idle minutes during the off range only.
swayidle -w timeout 1800 "t=\$(date +%H%M); $night || { date +'%F %T skip' >> $log; exit 0; }; date +'%F %T off' >> $log; wlopm --off '*'" resume "date +'%F %T on' >> $log; wlopm --on '*'" &
# Wake at the on time; at the off time, blank if the idle timeout was skipped and nobody touched since.
while true; do
  case "$(date +%H%M)" in
    "$on") wlopm --on "*" ;;
    "$off") tail -1 $log | grep -q skip && { date +'%F %T off' >> $log; wlopm --off "*"; } ;;
  esac
  sleep 30
done &
# On-screen keyboard pops up on focused text fields, including Google sign-in.
if command -v squeekboard >/dev/null; then
  gsettings set org.gnome.desktop.a11y.applications screen-keyboard-enabled true
  squeekboard &
fi
(
  until curl -fsS --max-time 5 http://localhost:8080/ >/dev/null; do
    sleep 2
  done
  while true; do
    date -Is >> /home/kiosk/.config/chromium-startup.log
    chromium --enable-logging=stderr --kiosk --no-first-run --noerrdialogs --ozone-platform=wayland --enable-wayland-ime --wayland-text-input-version=3 --user-data-dir=/home/kiosk/.config/chromium http://localhost:8080 >> /home/kiosk/.config/chromium-startup.log 2>&1
    sleep 3
  done
) &
