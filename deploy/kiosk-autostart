#!/bin/sh
log=/home/kiosk/.config/idle.log
# Blank after 30 idle minutes, except 07:00-23:59 when the display stays on.
swayidle -w timeout 1800 "[ \$(date +%H) -ge 7 ] && { date +'%F %T skip' >> $log; exit 0; }; date +'%F %T off' >> $log; wlopm --off '*'" resume "date +'%F %T on' >> $log; wlopm --on '*'" &
# Wake at 07:00; at midnight, blank if the idle timeout was skipped and nobody touched since.
while true; do
  case "$(date +%H%M)" in
    0700) wlopm --on "*" ;;
    0000) tail -1 $log | grep -q skip && { date +'%F %T off' >> $log; wlopm --off "*"; } ;;
  esac
  sleep 30
done &
(
  until curl -fsS --max-time 5 http://localhost:8080/ >/dev/null; do
    sleep 2
  done
  while true; do
    chromium --kiosk --no-first-run --noerrdialogs --ozone-platform=wayland --user-data-dir=/home/kiosk/.config/chromium http://localhost:8080 > /home/kiosk/.config/chromium-startup.log 2>&1
    sleep 3
  done
) &
