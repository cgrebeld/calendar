#!/bin/sh
# Blank after 30 idle minutes, except 07:00-11:59 when the display stays on.
swayidle -w timeout 1800 'h=$(date +%H); [ "$h" -ge 07 ] && [ "$h" -lt 12 ] && exit 0; date +"%F %T off" >> /home/kiosk/.config/idle.log; wlopm --off "*"' resume 'date +"%F %T on" >> /home/kiosk/.config/idle.log; wlopm --on "*"' &
(
  until curl -fsS --max-time 5 http://localhost:8080/ >/dev/null; do
    sleep 2
  done
  while true; do
    chromium --kiosk --no-first-run --noerrdialogs --ozone-platform=wayland --user-data-dir=/home/kiosk/.config/chromium http://localhost:8080 > /home/kiosk/.config/chromium-startup.log 2>&1
    sleep 3
  done
) &
