# Runtime settings for the Debian wall box, not the macOS .env.
WEB_PORT=8080
# Include every URL used to open the app so protected controls accept that origin.
APP_ORIGIN=http://localhost:8080,http://calendar-wall.local:8080
# Register this exact loopback redirect in the Google OAuth client.
GOOGLE_REDIRECT_URI=http://localhost:8080/api/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
WEATHER_LATITUDE=48.4284
WEATHER_LONGITUDE=-123.3656
WEATHER_UNITS=celsius
WEATHER_WIND_UNIT=kn
# Optional comma-separated Google Tasks list titles; unset shows all lists.
# TASK_LISTS=Reminders,Groceries
